{
  "name": "mcpanel-database",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "mcpanel-db": "./bin/mcpanel-db.ts"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "start": "tsx server.ts",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "db:migrate": "tsx src/database/migrator.ts migrate",
    "db:status": "tsx src/database/migrator.ts status",
    "db:rollback": "tsx src/database/migrator.ts rollback",
    "db:backup": "tsx scripts/backup.ts",
    "db:migrate:legacy": "tsx scripts/migrate-legacy.ts",
    "cli": "tsx bin/mcpanel-db.ts",
    "test": "tsx src/tests/run-all-tests.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@google/genai": "^2.4.0",
    "@node-rs/argon2": "^2.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/pg": "^8.23.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "swagger-ui-express": "^5.0.1",
    "vite": "^8.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
