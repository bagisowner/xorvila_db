# ==============================================================================
# MCPANEL DATABASE SERVICE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
# Either provide a full DATABASE_URL or individual host/port/user/password/name vars
DATABASE_URL=postgres://mcpanel:secure_mcpanel_password_change_me@127.0.0.1:5432/mcpanel_db
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=mcpanel_db
DATABASE_USER=mcpanel
DATABASE_PASSWORD=secure_mcpanel_password_change_me
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# Cryptography & Session Secrets (MUST be random strings >= 32 characters in production)
SESSION_SECRET=change_this_to_a_secure_random_64_character_string_for_production_sessions
API_KEY_SECRET=change_this_to_a_secure_random_64_character_string_for_api_key_hmac
TOKEN_SECRET=change_this_to_a_secure_random_64_character_string_for_jwt_tokens

# CORS Allowed Origins (Comma-separated, never use * in production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://panel.example.com

# OAuth 2.0 Providers
OAUTH_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/google/callback

OAUTH_DISCORD_ENABLED=false
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/discord/callback

# SMTP / Email Verification & Password Reset
EMAIL_ENABLED=false
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MCPANEL System <noreply@mcpanel.example.com>

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX=300

# Audit Log Retention (Days)
AUDIT_LOG_RETENTION_DAYS=90
